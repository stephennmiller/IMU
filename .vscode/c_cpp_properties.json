                "${env:HOME}/.arduino15/packages/arduino/hardware/avr/*/libraries/**",
                "${env:HOME}/.arduino15/packages/arduino/tools/avr-gcc/*/avr/include"
            ],
            "defines": [
                "ARDUINO=10607",
                "ARDUINO_AVR_UNO",
                "ARDUINO_ARCH_AVR",
                "F_CPU=16000000L",
                "__AVR_ATmega328P__"
            ],
            "cStandard": "c11",
            "cppStandard": "gnu++11",
            "intelliSenseMode": "gcc-x64",
            "compilerPath": "${env:HOME}/.arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-g++",
            "compilerArgs": ["-mmcu=atmega328p"]
        },
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/*/cores/arduino",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/*/variants/standard",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/*/libraries/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/*/avr/include"
            ],
            "defines": [
                "ARDUINO=10607",
                "ARDUINO_AVR_UNO",
                "ARDUINO_ARCH_AVR",
                "F_CPU=16000000L",
                "__AVR_ATmega328P__"
            ],
            "cStandard": "c11",
